// ===== 1m x 1m 레일 / 6x4 = 24 주차구역 제어 (리미트 스위치 통합) =====
// DFRobot Dual Bipolar Stepper Shield
#define X_STEP 6
#define X_DIR  7
#define X_EN   8
#define Y_STEP 5
#define Y_DIR  4
#define Y_EN   12

// ===== 리미트 스위치 =====
#define X_LIMIT 10   // X축 리미트 (INPUT_PULLUP, 눌리면 LOW)
#define Y_LIMIT 9    // Y축 리미트

// ===== 레일 범위 (실측값) =====
const long X_MAX = 31100;
const long Y_MAX = 29240;

// ===== 그리드 / 통로 설정 =====
const int  COLS = 6;
const int  ROWS = 4;
const long X_MARGIN = 2000;
const long Y_MARGIN = 2000;

const long X_CELL = (X_MAX - X_MARGIN * 2) / COLS;
const long Y_CELL = (Y_MAX - Y_MARGIN * 2) / ROWS;

// ===== 가감속 설정 =====
const int  FAST_DELAY  = 350;
const int  SLOW_DELAY  = 1000;
const long RAMP_STEPS  = 1500;

// ===== 상태 변수 =====
long curX = 0, curY = 0;
int  lastCol = -1, lastRow = -1;
volatile bool stopFlag = false;
char pendingCmd = 0;

// 리미트 스위치 눌림 확인
bool limitPressed(int pin) { return digitalRead(pin) == LOW; }

long cellCenterX(int col) { return X_MARGIN + X_CELL * col + X_CELL / 2; }
long cellCenterY(int row) { return Y_MARGIN + Y_CELL * row + Y_CELL / 2; }

void checkSerial() {
  while (Serial.available()) {
    char c = Serial.peek();
    if (c == 'e' || c == 'E') { Serial.read(); stopFlag = true; pendingCmd = 'e'; }
    else if (c == 's' || c == 'S') { Serial.read(); stopFlag = true; }
    else break;
  }
}

// 사다리꼴 가감속 이동 (리미트 스위치 감지 포함)
void moveAxis(int stepPin, int dirPin, int limitPin, long target, long &current) {
  long diff = target - current;
  if (diff == 0) return;
  digitalWrite(dirPin, diff > 0 ? HIGH : LOW);
  long steps = abs(diff);
  long dir = (diff > 0) ? 1 : -1;
  bool movingNeg = (dir < 0);   // 원점 방향 이동 여부

  for (long i = 0; i < steps; i++) {
    if (stopFlag) return;

    // ★ 리미트 스위치 감지 (원점 방향 이동 중일 때만)
    if (movingNeg && limitPressed(limitPin)) {
      current = 0;
      Serial.print(">> 리미트 감지! ");
      Serial.print(limitPin == X_LIMIT ? "X" : "Y");
      Serial.println("축 위치를 0으로 설정 후 정지");
      return;
    }

    int d;
    long remain = steps - i;
    if (steps <= RAMP_STEPS * 2) {
      d = SLOW_DELAY;
    } else if (i < RAMP_STEPS) {
      d = SLOW_DELAY - (long)(SLOW_DELAY - FAST_DELAY) * i / RAMP_STEPS;
    } else if (remain < RAMP_STEPS) {
      d = SLOW_DELAY - (long)(SLOW_DELAY - FAST_DELAY) * remain / RAMP_STEPS;
    } else {
      d = FAST_DELAY;
    }

    digitalWrite(stepPin, HIGH);
    delayMicroseconds(d);
    digitalWrite(stepPin, LOW);
    delayMicroseconds(d);
    current += dir;

    if ((i & 0x3F) == 0) checkSerial();
  }
}

bool moveTo(long tx, long ty) {
  if (tx < 0 || tx > X_MAX || ty < 0 || ty > Y_MAX) {
    Serial.println(">> 범위 벗어남! 이동 취소");
    return false;
  }
  moveAxis(X_STEP, X_DIR, X_LIMIT, tx, curX);
  if (stopFlag) return false;
  moveAxis(Y_STEP, Y_DIR, Y_LIMIT, ty, curY);
  return !stopFlag;
}

void moveToCell(int col, int row) {
  if (col < 0 || col >= COLS || row < 0 || row >= ROWS) {
    Serial.println(">> 구역 범위 벗어남! col:0~5, row:0~3");
    return;
  }
  if (moveTo(cellCenterX(col), cellCenterY(row))) {
    lastCol = col; lastRow = row;
    Serial.print(">> 구역 도착 ("); Serial.print(col);
    Serial.print(","); Serial.print(row);
    Serial.print(") 번호:"); Serial.print(row * COLS + col);
    Serial.print(" / X:"); Serial.print(curX);
    Serial.print(" Y:"); Serial.println(curY);
  }
}

void goHome() {
  Serial.println(">> 원점 복귀 시작");
  stopFlag = false;
  moveAxis(Y_STEP, Y_DIR, Y_LIMIT, 0, curY);
  if (stopFlag) return;
  moveAxis(X_STEP, X_DIR, X_LIMIT, 0, curX);
  if (!stopFlag) {
    lastCol = -1; lastRow = -1;
    Serial.println(">> 원점(0,0) 도착");
  }
}

void emergencyReturn() {
  Serial.print(">> 비상정지! 현재 X:"); Serial.print(curX);
  Serial.print(" Y:"); Serial.println(curY);
  delay(300);
  stopFlag = false;
  goHome();
  Serial.println(">> 비상복귀 완료");
}

void printStatus() {
  Serial.println("===== 상태 =====");
  Serial.print("현재 좌표  X:"); Serial.print(curX);
  Serial.print(" Y:"); Serial.println(curY);
  if (lastCol >= 0) {
    Serial.print("현재 구역  ("); Serial.print(lastCol);
    Serial.print(","); Serial.print(lastRow);
    Serial.print(") 번호:"); Serial.println(lastRow * COLS + lastCol);
  } else {
    Serial.println("현재 구역  원점/구역밖");
  }
  Serial.print("리미트     X:"); Serial.print(limitPressed(X_LIMIT) ? "눌림" : "정상");
  Serial.print(" / Y:"); Serial.println(limitPressed(Y_LIMIT) ? "눌림" : "정상");
  Serial.print("동작 상태  "); Serial.println(stopFlag ? "정지" : "대기");
  Serial.println("================");
}

// ===== 수동 조그 (리미트 스위치 감지 포함) =====
// 리미트 눌리면 정지 + 해당 축 0으로 설정
void jogAxis(int stepPin, int dirPin, int limitPin, long steps, bool positive, long &current) {
  digitalWrite(dirPin, positive ? HIGH : LOW);
  long moved = 0;
  bool limitHit = false;

  for (long i = 0; i < steps; i++) {
    if (Serial.available()) {
      char c = Serial.peek();
      if (c == 's' || c == 'S') {
        Serial.read();
        Serial.println(">> 조그 정지");
        break;
      }
    }

    // ★ 리미트 감지 (음의 방향으로 이동 중일 때만)
    if (!positive && limitPressed(limitPin)) {
      Serial.print(">> 리미트 감지! ");
      Serial.print(limitPin == X_LIMIT ? "X" : "Y");
      Serial.println("축을 0으로 설정 후 정지");
      limitHit = true;
      break;
    }

    digitalWrite(stepPin, HIGH);
    delayMicroseconds(SLOW_DELAY);
    digitalWrite(stepPin, LOW);
    delayMicroseconds(SLOW_DELAY);
    moved++;
  }

  if (limitHit) {
    current = 0;
  } else {
    current += positive ? moved : -moved;
  }
}

void jogMode() {
  Serial.println("===== 수동 조그 모드 =====");
  Serial.println("x+ / x- : X축 이동   y+ / y- : Y축 이동");
  Serial.println("기본 100스텝, 'x+500' 처럼 숫자 붙이면 그만큼 이동");
  Serial.println("이동 중 s : 즉시 정지");
  Serial.println("이동 중 리미트 감지 시 자동 정지 + 해당 축 0으로 설정");
  Serial.println("z : 현재 위치를 (0,0)으로 재설정   q : 조그모드 종료");

  while (true) {
    if (!Serial.available()) continue;

    String cmd = Serial.readStringUntil('\n');
    cmd.trim();
    if (cmd.length() == 0) continue;

    if (cmd == "q" || cmd == "Q") {
      Serial.println(">> 조그모드 종료");
      return;
    }
    else if (cmd == "z" || cmd == "Z") {
      curX = 0; curY = 0;
      lastCol = -1; lastRow = -1;
      Serial.println(">> 현재 위치를 (0,0) 원점으로 재설정 완료!");
    }
    else if (cmd.startsWith("x") || cmd.startsWith("X") ||
             cmd.startsWith("y") || cmd.startsWith("Y")) {
      char axis = tolower(cmd.charAt(0));
      char sign = cmd.charAt(1);
      if (sign != '+' && sign != '-') {
        Serial.println(">> 형식 오류 (x+ / x- / y+ / y-)");
        continue;
      }
      bool pos = (sign == '+');
      long n = 100;
      if (cmd.length() > 2) {
        long v = cmd.substring(2).toInt();
        if (v > 0) n = v;
      }
      if (axis == 'x') {
        jogAxis(X_STEP, X_DIR, X_LIMIT, n, pos, curX);
      } else {
        jogAxis(Y_STEP, Y_DIR, Y_LIMIT, n, pos, curY);
      }
      Serial.print(">> 이동 후 X:"); Serial.print(curX);
      Serial.print(" Y:"); Serial.println(curY);
    }
    else {
      Serial.println(">> 알 수 없는 명령 (x+/x-/y+/y-/z/q)");
    }
  }
}

void setup() {
  pinMode(X_STEP, OUTPUT); pinMode(X_DIR, OUTPUT); pinMode(X_EN, OUTPUT);
  pinMode(Y_STEP, OUTPUT); pinMode(Y_DIR, OUTPUT); pinMode(Y_EN, OUTPUT);
  pinMode(X_LIMIT, INPUT_PULLUP);   // ★ 리미트 스위치
  pinMode(Y_LIMIT, INPUT_PULLUP);
  digitalWrite(X_EN, LOW);
  digitalWrite(Y_EN, LOW);

  Serial.begin(9600);
  Serial.println("===== 24구역 레일 제어 =====");
  Serial.println("[이동] 숫자 1개(0~23)=구역번호 / 숫자 2개=열 행");
  Serial.println("[명령] h=원점복귀  e=비상정지+복귀  s=정지  t=상태조회");
  Serial.println("[비상] j=수동 조그모드(위치 꼬였을 때 복구)");
  Serial.println("[리미트] X:D10 / Y:D9, 원점 방향 이동 중 감지 시 자동 정지+0설정");
}

void loop() {
  if (!Serial.available()) return;

  int peek = Serial.peek();

  if (peek == 'h' || peek == 'H') {
    Serial.read(); goHome();
  } else if (peek == 'e' || peek == 'E') {
    Serial.read(); emergencyReturn();
  } else if (peek == 't' || peek == 'T') {
    Serial.read(); printStatus();
  } else if (peek == 'j' || peek == 'J') {
    Serial.read(); jogMode();
  } else if (peek == 's' || peek == 'S') {
    Serial.read(); stopFlag = true; Serial.println(">> 정지");
  } else if (peek == '-' || (peek >= '0' && peek <= '9')) {
    stopFlag = false;
    long a = Serial.parseInt();
    delay(15);
    if (Serial.available() && Serial.peek() != '\n' && Serial.peek() != '\r'
        && (Serial.peek() == ' ' || (Serial.peek() >= '0' && Serial.peek() <= '9'))) {
      long b = Serial.parseInt();
      moveToCell((int)a, (int)b);
    } else {
      int idx = (int)a;
      moveToCell(idx % COLS, idx / COLS);
    }
  } else {
    Serial.read();
  }

  while (Serial.available() &&
        (Serial.peek() == '\n' || Serial.peek() == '\r' || Serial.peek() == ' '))
    Serial.read();
}





//조그모드등 여러가지 기능을 넣은 코드//
// ===== [2번 코드] 18구역 주차장 실제 제어 (시작 시 원점 대기) =====
// 물리적 원점(MIN): X=0, Y=0 / A1(초기위치): 물리적 X=0, Y=MAX

#include <string.h>

struct Axis {
  int stepPin, dirPin, minSw, maxSw;
  bool dirMinus, dirPlus;
  const char* label;
};

// ---- 모터 핀 ----
#define X_STEP 6
#define X_DIR  7
#define X_EN   8
#define Y_STEP 5
#define Y_DIR  4
#define Y_EN   12

// ---- 리미트 스위치 ----
#define X_MIN_SW 9
#define X_MAX_SW 11
#define Y_MIN_SW 10
#define Y_MAX_SW 3

Axis xAxis = {X_STEP, X_DIR, X_MIN_SW, X_MAX_SW, HIGH, LOW, "X"};
Axis yAxis = {Y_STEP, Y_DIR, Y_MIN_SW, Y_MAX_SW, HIGH, LOW, "Y"};

// ★★★ 여기에 1번 코드(캘리브레이션)에서 나온 스텝 수를 직접 입력하세요! ★★★
long X_MAX_STEPS = 28128; // (예시) X축 측정값 입력
long Y_MAX_STEPS = 29881; // (예시) Y축 측정값 입력
// ★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★

double scaleX = 0.0;
double scaleY = 0.0;

const int FAST_DELAY = 350;
const int SLOW_DELAY = 1000;
const long RAMP_STEPS = 1500;
const int BACKOFF_STEPS = 200;

// ---- 도면 좌표 데이터 (90도 반시계 회전 적용) ----
const double posX_cm[3] = {13.0, 43.0, 73.0}; // A(좌측), B(중앙), C(우측)
const double posY_cm[6] = {7.75, 21.25, 34.75, 54.25, 67.75, 81.25}; // 1(하단) ~ 6(상단)

// ---- 상태 변수 ----
long curX = 0, curY = 0;
int lastColIdx = -1, lastRowIdx = -1;
volatile bool stopFlag = false;

void stepOnce(int stepPin, int delayUs) {
  digitalWrite(stepPin, HIGH); delayMicroseconds(delayUs);
  digitalWrite(stepPin, LOW);  delayMicroseconds(delayUs);
}

void checkStopMoving() {
  if (Serial.available()) {
    char c = Serial.peek();
    if (c == 's' || c == 'S' || c == 'e' || c == 'E') {
      Serial.read(); stopFlag = true;
      Serial.println(F("\n>> 정지 명령 수신"));
    }
  }
}

void moveAxis(Axis &ax, long target, long &current) {
  long diff = target - current;
  if (diff == 0) return;
  
  bool movingNeg = (diff < 0);
  digitalWrite(ax.dirPin, movingNeg ? ax.dirMinus : ax.dirPlus);
  
  long steps = abs(diff);
  long dir = movingNeg ? -1 : 1;

  for (long i = 0; i < steps; i++) {
    if (stopFlag) return; 

    if (movingNeg && digitalRead(ax.minSw) == LOW) {
      current = 0; return;
    }
    if (!movingNeg && digitalRead(ax.maxSw) == LOW) {
      current = (ax.label[0] == 'X') ? X_MAX_STEPS : Y_MAX_STEPS; return;
    }

    int d;
    long remain = steps - i;
    if (steps <= RAMP_STEPS * 2) d = SLOW_DELAY;
    else if (i < RAMP_STEPS) d = SLOW_DELAY - (long)(SLOW_DELAY - FAST_DELAY) * i / RAMP_STEPS;
    else if (remain < RAMP_STEPS) d = SLOW_DELAY - (long)(SLOW_DELAY - FAST_DELAY) * remain / RAMP_STEPS;
    else d = FAST_DELAY;

    stepOnce(ax.stepPin, d);
    current += dir; 
    if ((i & 0x3F) == 0) checkStopMoving();
  }
}

bool moveTo(long tx, long ty) {
  if (tx < 0 || tx > X_MAX_STEPS || ty < 0 || ty > Y_MAX_STEPS) {
    Serial.println(F(">> 범위 이탈! 이동 취소")); return false;
  }
  moveAxis(yAxis, ty, curY);
  if (stopFlag) return false;
  moveAxis(xAxis, tx, curX);
  return !stopFlag;
}

void moveToCell(int col_idx, int row_idx) {
  if (col_idx < 0 || col_idx >= 3 || row_idx < 0 || row_idx >= 6) return;
  
  long tx = posX_cm[col_idx] * scaleX;
  long ty = Y_MAX_STEPS - (posY_cm[row_idx] * scaleY); // Y축 반전
  
  char colChar = 'A' + col_idx;
  int rowNum = row_idx + 1;
  
  Serial.print(F(">> [")); Serial.print(colChar); Serial.print(rowNum); 
  Serial.print(F("] 구역 이동 (목표 X:")); Serial.print(tx);
  Serial.print(F(" Y:")); Serial.print(ty); Serial.println(F(")"));
  
  if (moveTo(tx, ty)) {
    lastColIdx = col_idx; lastRowIdx = row_idx;
  }
}

// 안전한 원점 복귀 (스위치 잘못 눌림 방지 포함)
void forceHome(Axis &ax, long &current) {
  digitalWrite(ax.dirPin, ax.dirMinus); 
  while (digitalRead(ax.minSw) != LOW) {
    if (stopFlag) return;
    // 만약 실수로 반대편(MAX)이 눌리면 방향을 뒤집어서 원점으로 가도록 보호
    if (digitalRead(ax.maxSw) == LOW) {
      bool tmp = ax.dirMinus; ax.dirMinus = ax.dirPlus; ax.dirPlus = tmp;
      digitalWrite(ax.dirPin, ax.dirMinus);
      delay(100);
      while(digitalRead(ax.maxSw) == LOW) stepOnce(ax.stepPin, SLOW_DELAY);
    }
    stepOnce(ax.stepPin, SLOW_DELAY); 
    if (Serial.available()) checkStopMoving();
  }
  digitalWrite(ax.dirPin, ax.dirPlus);
  for(int i=0; i<BACKOFF_STEPS; i++) stepOnce(ax.stepPin, SLOW_DELAY);
  current = BACKOFF_STEPS; 
}

void goHome() {
  Serial.println(F("\n>> 물리적 원점(X=0, Y=0) 복귀 시작"));
  stopFlag = false;
  forceHome(xAxis, curX);
  if (stopFlag) return;
  forceHome(yAxis, curY);
  if (!stopFlag) { lastColIdx = -1; lastRowIdx = -1; Serial.println(F(">> 원점 복귀 완료")); }
}

void printStatus() {
  Serial.println(F("\n===== 현재 상태 ====="));
  Serial.print(F("물리적 좌표  X:")); Serial.print(curX); Serial.print(F(" Y:")); Serial.println(curY);
  if (lastColIdx >= 0) {
    Serial.print(F("주차 구역    ")); Serial.print((char)('A' + lastColIdx)); Serial.println(lastRowIdx + 1);
  } else {
    Serial.println(F("주차 구역    미확인(원점 또는 이동중)"));
  }
  Serial.println(F("====================="));
}

void jogAxis(Axis &ax, long steps, bool positive, long &current) {
  digitalWrite(ax.dirPin, positive ? ax.dirPlus : ax.dirMinus);
  long moved = 0; bool limitHit = false;
  for (long i = 0; i < steps; i++) {
    if (Serial.available() && (tolower(Serial.peek()) == 's')) { Serial.read(); break; }
    if (!positive && digitalRead(ax.minSw) == LOW) { limitHit = true; break; }
    if (positive && digitalRead(ax.maxSw) == LOW) break;
    stepOnce(ax.stepPin, SLOW_DELAY); moved++;
  }
  if (limitHit) current = 0; else current += positive ? moved : -moved; 
}

void jogMode() {
  Serial.println(F("\n===== 수동 조그 모드 ====="));
  while (true) {
    if (!Serial.available()) continue;
    String cmd = Serial.readStringUntil('\n'); cmd.trim();
    if (cmd.length() == 0) continue;
    if (cmd == "q" || cmd == "Q") return;
    else if (cmd.startsWith("x") || cmd.startsWith("X") || cmd.startsWith("y") || cmd.startsWith("Y")) {
      char axis = tolower(cmd.charAt(0)); char sign = cmd.charAt(1);
      if (sign != '+' && sign != '-') continue;
      long n = (cmd.length() > 2) ? cmd.substring(2).toInt() : 100;
      if (n <= 0) n = 100;
      if (axis == 'x') jogAxis(xAxis, n, (sign == '+'), curX);
      else             jogAxis(yAxis, n, (sign == '+'), curY);
    }
  }
}

void setup() {
  Serial.begin(9600);
  pinMode(X_STEP, OUTPUT); pinMode(X_DIR, OUTPUT); pinMode(X_EN, OUTPUT);
  pinMode(Y_STEP, OUTPUT); pinMode(Y_DIR, OUTPUT); pinMode(Y_EN, OUTPUT);
  pinMode(X_MIN_SW, INPUT_PULLUP); pinMode(X_MAX_SW, INPUT_PULLUP);
  pinMode(Y_MIN_SW, INPUT_PULLUP); pinMode(Y_MAX_SW, INPUT_PULLUP);

  digitalWrite(X_EN, LOW); digitalWrite(Y_EN, LOW);

  // 스케일 계산
  if (X_MAX_STEPS > 0) scaleX = (double)X_MAX_STEPS / 86.0;
  if (Y_MAX_STEPS > 0) scaleY = (double)Y_MAX_STEPS / 89.0;

  goHome(); // 전원 켜면 즉시 원점 잡고 대기 (이동 코드 삭제)
  
  Serial.println(F("\n===== 18구역 제어 준비 완료 (원점 대기) ====="));
  Serial.println(F("이동할 구역을 입력하세요 (예: A1, C6)"));
}

void loop() {
  if (!Serial.available()) return;
  char firstChar = tolower(Serial.read());

  if (firstChar == 'h') goHome();
  else if (firstChar == 'e') { stopFlag = false; goHome(); }
  else if (firstChar == 't') printStatus();
  else if (firstChar == 'j') jogMode();
  else if (firstChar == 's') { stopFlag = true; Serial.println(F(">> 즉시 정지 명령")); }
  else if (firstChar >= 'a' && firstChar <= 'c') {
    delay(20); 
    if (Serial.available()) {
      char rowChar = Serial.read(); 
      int row_idx = rowChar - '1'; 
      int col_idx = (firstChar == 'a') ? 0 : (firstChar == 'b' ? 1 : 2);
      if (row_idx >= 0 && row_idx < 6) {
        stopFlag = false; moveToCell(col_idx, row_idx);
      } else { Serial.println(F(">> [오류] 잘못된 구역입니다. (예: A1 ~ C6)")); }
    }
  }
  while (Serial.available() && (Serial.peek() == '\n' || Serial.peek() == '\r' || Serial.peek() == ' ')) Serial.read();
}
