// ==========================================
// Z축 모터
// CNC Shield X축 슬롯 사용
// ==========================================
#define STEP_PIN 2
#define DIR_PIN  5
#define EN_PIN   8


// ==========================================
// 방향
// + = 상승
// - = 하강
// ==========================================
#define UP_DIR   LOW
#define DOWN_DIR HIGH


// ==========================================
// 속도
// 작을수록 빠름
// ==========================================
const int STEP_DELAY_US = 600;


// ==========================================
// 모터 상태
//  0 = 정지
//  1 = 상승
// -1 = 하강
// ==========================================
int motorState = 0;


void setup() {

  Serial.begin(9600);

  pinMode(STEP_PIN, OUTPUT);
  pinMode(DIR_PIN, OUTPUT);
  pinMode(EN_PIN, OUTPUT);

  digitalWrite(STEP_PIN, LOW);

  // 처음에는 모터 정지
  digitalWrite(EN_PIN, HIGH);

  Serial.println("========================");
  Serial.println(" Z AXIS READY");
  Serial.println("========================");
  Serial.println("+ = UP");
  Serial.println("- = DOWN");
  Serial.println("s = STOP");
}


void loop() {

  // ========================================
  // 시리얼 모니터 명령 수신
  // ========================================
  if (Serial.available() > 0) {

    char command = Serial.read();


    // + : 계속 상승
    if (command == '+') {

      motorState = 1;

      digitalWrite(DIR_PIN, UP_DIR);
      digitalWrite(EN_PIN, LOW);

      Serial.println("UP");
    }


    // - : 계속 하강
    else if (command == '-') {

      motorState = -1;

      digitalWrite(DIR_PIN, DOWN_DIR);
      digitalWrite(EN_PIN, LOW);

      Serial.println("DOWN");
    }


    // s : 정지
    else if (command == 's' || command == 'S') {

      motorState = 0;

      digitalWrite(STEP_PIN, LOW);
      digitalWrite(EN_PIN, HIGH);

      Serial.println("STOP");
    }
  }


  // ========================================
  // 모터 연속 회전
  // s를 받을 때까지 계속 움직임
  // ========================================
  if (motorState != 0) {

    digitalWrite(STEP_PIN, HIGH);
    delayMicroseconds(STEP_DELAY_US);

    digitalWrite(STEP_PIN, LOW);
    delayMicroseconds(STEP_DELAY_US);
  }
}
